[Unit]
Description=tblogs — read-only blog server
Documentation=https://github.com/your-account/tblogs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tblogs
Group=tblogs
WorkingDirectory=/opt/tblogs

# The content package: `site.db` and `media/`, both produced by
# `tblogs-admin build` and delivered by `tblogs-admin publish`. This service
# only ever reads them, so it must not be able to rewrite them.
Environment=TBLOGS_DATA_DIR=/opt/tblogs/data

# Bind to loopback only: nginx/Caddy terminates TLS and proxies to this port.
# Never widen this unless you really intend to bypass the proxy.
Environment=TBLOGS_BIND=127.0.0.1:8080

Environment=RUST_LOG=tblogs=info,tower_http=warn

# Optional overrides. The site title, description and public URL normally come
# from the package itself, so this file is usually unnecessary.
#
#   TBLOGS_SITE_TITLE=我的博客
#   TBLOGS_SITE_URL=https://blog.example.com
#   TBLOGS_RELOAD_INTERVAL=5
#
EnvironmentFile=-/etc/tblogs.env

ExecStart=/opt/tblogs/tblogs-server
Restart=on-failure
RestartSec=2s

# Hardening. `ProtectSystem=strict` makes the whole filesystem read-only apart
# from /dev, /proc and /sys, which is exactly right here: the server has no
# legitimate reason to write anything.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
